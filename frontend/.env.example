# Email Security Pipeline dashboard — environment configuration.
# Copy this file to `.env.local` (gitignored) and fill in the values.
# NEVER commit real values. All are read via import.meta.env at build/runtime.

# Base URL of the FastAPI inference service.
#   dev: https://esp-api.naratech.xyz
VITE_API_BASE_URL=

# Cognito user pool that backs dashboard auth.
#   dev value is emitted by `terraform output cognito_pool_id` (infra/envs/dev).
VITE_COGNITO_USER_POOL_ID=

# Cognito app client id for the dashboard.
#   dev value is emitted by `terraform output cognito_client_id` (infra/envs/dev).
VITE_COGNITO_CLIENT_ID=

# AWS region the user pool lives in.
VITE_COGNITO_REGION=

# Deployment environment label shown in the top-bar badge: DEV or PROD.
VITE_APP_ENV=DEV
